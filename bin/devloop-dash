#!/usr/bin/env python3
"""Thin launcher: put the devloop package on sys.path, then call it."""

import os
import sys
from pathlib import Path

here = Path(__file__).resolve().parent.parent
lib = os.environ.get("DEVLOOP_LIB") or (
    str(here)
    if (here / "devloop" / "__init__.py").is_file()
    else str(Path.home() / ".local" / "share" / "devloop" / "lib")
)
sys.path.insert(0, lib)
# `--detach` starts this same launcher again from this directory.
os.environ.setdefault("DEVLOOP_BIN_DIR", str(Path(__file__).resolve().parent))

from devloop.dash.lifecycle import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
