#!/usr/bin/env python3
"""Record that the quality gate passed for the current HEAD.

Run it only after the review roster for the slice's risk passed on this head (R1 Codex
GO, R2 Dennis then Codex GO), no BLOCKER or HIGH is left, and the docs are synced. The receipt is the commit SHA in the worktree's git dir, so the
next commit re-arms the gate. `hooks/pr_gate.py` is the only reader of this file.
"""

import os
import subprocess
import sys
from pathlib import Path

here = Path(__file__).resolve().parent.parent
lib = os.environ.get("DEVLOOP_LIB") or (
    str(here)
    if (here / "devloop" / "__init__.py").is_file()
    else str(Path.home() / ".local" / "share" / "devloop" / "lib")
)
sys.path.insert(0, lib)

from devloop import project  # noqa: E402


def git(*args):
    r = subprocess.run(["git", *args], capture_output=True, text=True, check=False)
    return r.stdout.strip() if r.returncode == 0 else None


def main() -> int:
    head = git("rev-parse", "HEAD")
    git_dir = git("rev-parse", "--absolute-git-dir")
    if not head or not git_dir:
        print(
            "devloop-gate-pass: run it inside a git worktree with a commit",
            file=sys.stderr,
        )
        return 1
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    repos, _ = project.configured_repos()
    receipt = project.gate_for(repos, Path(common).parent.resolve() if common else None)[
        "receipt"
    ]
    final = os.path.join(git_dir, receipt)
    tmp = f"{final}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(head + "\n")
        os.replace(tmp, final)
    except OSError:
        if os.path.exists(tmp):
            os.unlink(tmp)
        print("devloop-gate-pass: cannot write the receipt", file=sys.stderr)
        return 1
    print(
        f"quality gate recorded for HEAD {head}; gh pr create is unblocked for this commit"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
