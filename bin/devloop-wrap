#!/usr/bin/env python3
"""Thin launcher: put the devloop package on sys.path, then run the worker wrapper."""

import os
import sys
from pathlib import Path

here = Path(__file__).resolve().parent.parent
lib = os.environ.get("DEVLOOP_LIB") or (
    str(here)
    if (here / "devloop" / "__init__.py").is_file()
    else str(Path.home() / ".local" / "share" / "devloop" / "lib")
)
sys.path.insert(0, lib)
# The wrapper and the tick start each other by this directory.
os.environ.setdefault("DEVLOOP_BIN_DIR", str(Path(__file__).resolve().parent))

from devloop.wrap import run  # noqa: E402

sys.exit(run(sys.argv[1], sys.argv[2]))
