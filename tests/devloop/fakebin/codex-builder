#!/usr/bin/env bash
# Fake codex-builder <worktree>: commits one change in the worktree, like a Codex fixer.
# FAKE_EXIT makes it fail; FAKE_NO_COMMIT leaves the tree alone.
cd "$1" || exit 2
if [ -z "${FAKE_NO_COMMIT:-}" ]; then
  echo "codex fix" >> codex-fix.txt
  git add -A
  git -c user.name=t -c user.email=t@t commit -qm "codex fix"
fi
exit "${FAKE_EXIT:-0}"
